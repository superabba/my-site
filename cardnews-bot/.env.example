# ===== Claude =====
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
CARD_EFFORT=high            # low | medium | high (낮출수록 저렴·빠름)
CLAUDE_WEB_SEARCH=true        # 원고 작성 전 웹 검색으로 사실 확인
CLAUDE_FALLBACKS=default      # 거절 시 서버측 폴백 모델로 재시도 (끄려면 off)

# ===== 콘텐츠 방향 =====
CARD_NICHE=20~40대 직장인을 위한 돈·생활·테크 꿀팁
CARD_TONE=친근하고 명확한 존댓말
BRAND_HANDLE=my_account
CARD_THEME=midnight           # midnight | cream | mint | coral
SLIDES_MIN=5
SLIDES_MAX=8

# ===== 트렌드 소스 =====
TREND_GEO=KR
YOUTUBE_API_KEY=              # 선택: YouTube 인기 동영상 신호
EXTRA_RSS=                    # 선택: 쉼표로 구분한 RSS URL

# ===== 이미지 호스팅 (Instagram/Threads는 공개 URL의 JPEG만 받음) =====
IMAGE_HOSTING=github          # github | s3 | local
GITHUB_TOKEN=                 # contents:write 권한의 fine-grained 토큰
GITHUB_REPO=owner/public-repo # 반드시 public 저장소
GITHUB_BRANCH=main
GITHUB_DIR=cardnews
# S3/R2 사용 시
S3_BUCKET=
S3_ENDPOINT=                  # R2: https://<account>.r2.cloudflarestorage.com
S3_PREFIX=cardnews
PUBLIC_BASE_URL=              # s3/local: 공개 접근 URL
PUBLIC_DIR=                   # local: 웹서버가 서빙하는 폴더

# ===== 플랫폼 =====
PLATFORMS=instagram,threads
IG_USER_ID=
IG_ACCESS_TOKEN=              # instagram_business_basic, instagram_business_content_publish, instagram_business_manage_insights
IG_GRAPH_BASE=https://graph.instagram.com/v23.0
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=         # threads_basic, threads_content_publish, threads_manage_insights
THREADS_GRAPH_BASE=https://graph.threads.net/v1.0

# ===== 자동화 =====
AUTO_PUBLISH=false            # true면 사람 검토 없이 바로 게시
INTERVAL_MINUTES=240
POSTS_PER_RUN=1
